# Ignore other modules when building specific services
# Note: pii-detector-service and pii-reporting-api both use root context
# Only ignore pii-reporting-ui when not building it
pii-reporting-ui/
my-files/

# Git
.git
.gitignore
.agents/
.claude/
.codex/
.worktrees/
graphify-out/
benchmarks/
qa/
secrets/
certs/
personally-identifiable-information-scan-results/
**/.venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.coverage

# Documentation at root
README.md
QUICKSTART.md
DOCKER_DEPLOYMENT.md

# IDE
.idea/
*.iml
.vscode/

# Build artifacts in pii-reporting-api (will be rebuilt in Docker)
pii-reporting-api/target/

# Local model exports (mounted as volumes, never COPYed — keeps large model
# exports out of every build context)
pii-detector-service/models/
pii-detector-service/target/

# Scripts
start-app.sh
start-app.ps1

# Env files
.env
.env.*

# Keep these files for pii-reporting-api build:
# - pii-reporting-api/pom.xml
# - pii-reporting-api/src/
# - pii-reporting-api/Dockerfile
# - proto/
